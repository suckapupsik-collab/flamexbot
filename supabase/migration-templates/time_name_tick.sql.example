-- The .time minute job is installed by the production migration
-- flamexbot_time_tick_vault_auth. Its random auth secret is stored in Supabase Vault.
-- Do not place a token or secret value in this file or in cron.job.command.
-- Read-only status check:
select jobname, schedule, active
from cron.job
where jobname = 'flamexbot-time-tick';
