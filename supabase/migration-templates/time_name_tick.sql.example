-- Refreshes the clock in Telegram Business names set by .time once a minute.
-- Requires pg_cron and pg_net.
-- Do not commit a real secret here. Replace the placeholder in the SQL editor only after
-- setting FLAMEXBOT_TIME_TICK_SECRET as a Supabase Edge Function secret and deploying the bot
-- handler to validate that dedicated secret (the Telegram webhook secret is not for cron).
-- This is a manual template; it is not an active migration.
create extension if not exists pg_cron;
create extension if not exists pg_net;

select cron.unschedule('flamexbot-time-tick')
where exists (select 1 from cron.job where jobname = 'flamexbot-time-tick');

select cron.schedule(
  'flamexbot-time-tick',
  '* * * * *',
  $$
  select net.http_post(
    url := 'https://yxmfhnbqzudoiwjlrpui.supabase.co/functions/v1/flamexbot-bot',
    headers := jsonb_build_object(
      'content-type', 'application/json',
      'x-flamexbot-job', 'time-tick',
      'x-flamexbot-job-secret', '<FLAMEXBOT_TIME_TICK_SECRET>'
    ),
    body := '{}'::jsonb
  );
  $$
);
